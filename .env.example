# ============================================================
# XES input file
# ============================================================

# Replace this with your local XES file path.
# Example:
# XES_PATH="./data/examples/Choice_Merge_case/Choice_Merge_case1.xes"
XES_PATH="./data/Sepsis Cases - tests only.xes"


# ============================================================
# Transition system construction
# ============================================================

# State abstraction view: sequence | set | multiset
VIEW=set

# Window size used for transition system construction
WINDOW=20

# Event attribute used as activity label
ACTIVITY_KEY=concept:name

# TS construction direction: forward | backward
DIRECTION=backward

# Self-loop filtering thresholds
MIN_SELF_LOOP_FREQ_RATIO_TO_STATE=0.5
MIN_SELF_LOOP_FREQ_AMOUNT_TO_STATE=1000


# ============================================================
# Approximate label splitting
# ============================================================

# Use approximate region discovery instead of classical label splitting method
APPROXIMATE_REGION_METHOD=true

# Violation cost function name
# The name should match a function defined in src/violation_costs.py
VIOLATION_COST_FN=violation_cost_violating_freq

# Maximum allowed violation cost for accepting an approximate region
APPROX_COST_THRESHOLD=0.14

# Minimum coverage ratio required for the main behavior pattern
MIN_MAIN_BEHAVIOUR_COVERAGE_RATIO=0.8

# Minimum label frequency required before label splitting is triggered
MIN_FREQ_TO_TRIGGER_LABEL_SPLITTING=10


# ============================================================
# Region-to-place filtering
# ============================================================

# Minimum frequency ratio for keeping crossing behavior when deriving places
MIN_CROSSING_FREQ_RATIO=0.2

# Minimum absolute frequency for keeping crossing behavior when deriving places
MIN_CROSSING_FREQ_AMOUNT=50


# ============================================================
# Petri net output
# ============================================================

NET_NAME=Net

# Whether to open/render the Petri net visualization
VIEW_PETRI_NET=true


# ============================================================
# Save results
# ============================================================

# Whether to save generated outputs to the output directory
SAVE_RESULTS=true